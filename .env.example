# ========================================================
# To-Do List Application - Environment Variables Template
# ========================================================
# Copy this file to '.env' for local configuration.
# DO NOT commit real secrets or credentials to GitHub!
# For Jenkins CI/CD, configure these in:
# Jenkins -> Credentials or Pipeline Environment Variables.

# Database Connection Settings
DB_HOST=localhost
DB_PORT=3306
DB_NAME=todo_app
DB_USER=root
DB_PASS=your_secure_password_here

# Application Environment (development / staging / production)
APP_ENV=development
APP_DEBUG=true
APP_URL=http://localhost:8000
